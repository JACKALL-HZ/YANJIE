{
  "scenario_id": "retail_store",
  "title": "零售小店创业",
  "version": 1,
  "decision_vars": [
    {
      "name": "budget",
      "value_type": "integer",
      "required": true,
      "default": 300000,
      "minimum": 50000,
      "maximum": 2000000
    },
    {
      "name": "city",
      "value_type": "string",
      "required": true,
      "default": "shenzhen"
    },
    {
      "name": "industry",
      "value_type": "string",
      "required": true,
      "default": "retail"
    },
    {
      "name": "span_years",
      "value_type": "integer",
      "required": false,
      "default": 3,
      "minimum": 1,
      "maximum": 5
    }
  ],
  "initial_world_state": {
    "cash_flow": 300000,
    "customer_flow": 80,
    "competition_count": 55,
    "monthly_profit": -5000,
    "payback_ratio": 0
  },
  "agents": [
    {
      "agent_id": "market",
      "name": "市场智能体",
      "stance": "关注顾客需求与竞争格局",
      "goal": "提升获客能力，同时避免耗尽现金储备",
      "action_ids": ["market.differentiate", "market.hold"]
    },
    {
      "agent_id": "environment",
      "name": "环境智能体",
      "stance": "关注所在地与经营环境",
      "goal": "让门店适应当地经营条件",
      "action_ids": ["environment.localize", "environment.monitor"]
    },
    {
      "agent_id": "personal",
      "name": "个人智能体",
      "stance": "关注创始人的能力与精力",
      "goal": "让创始人保持可持续的执行节奏",
      "action_ids": ["personal.stabilize", "personal.defer"]
    },
    {
      "agent_id": "risk",
      "name": "风险智能体",
      "stance": "关注下行损失与脆弱点",
      "goal": "限制不可逆损失和竞争压力",
      "action_ids": ["risk.contain", "risk.insure"]
    }
  ],
  "action_effects": [
    {
      "action_id": "market.differentiate",
      "effects": {
        "cash_flow": -30000,
        "customer_flow": 25,
        "competition_count": -3,
        "monthly_profit": 6000,
        "payback_ratio": 0.08
      },
      "reason_template": "Differentiate product assortment to attract loyal shoppers."
    },
    {
      "action_id": "market.hold",
      "effects": {
        "cash_flow": -8000,
        "customer_flow": 3,
        "monthly_profit": 500,
        "payback_ratio": 0.01
      },
      "reason_template": "Maintain current assortment and monitor foot traffic."
    },
    {
      "action_id": "environment.localize",
      "effects": {
        "cash_flow": -15000,
        "customer_flow": 12,
        "monthly_profit": 3000,
        "payback_ratio": 0.04
      },
      "reason_template": "Adapt store layout and hours to neighborhood patterns."
    },
    {
      "action_id": "environment.monitor",
      "effects": {
        "cash_flow": -3000,
        "monthly_profit": 300,
        "payback_ratio": 0.01
      },
      "reason_template": "Survey local competition and foot traffic before investing."
    },
    {
      "action_id": "personal.stabilize",
      "effects": {
        "cash_flow": -10000,
        "monthly_profit": 2000,
        "payback_ratio": 0.04
      },
      "reason_template": "Hire one part-time assistant to reduce founder burnout."
    },
    {
      "action_id": "personal.defer",
      "effects": {
        "cash_flow": -2000,
        "monthly_profit": 200,
        "payback_ratio": 0.01
      },
      "reason_template": "Keep lean operations, delay hiring decisions."
    },
    {
      "action_id": "risk.contain",
      "effects": {
        "cash_flow": -12000,
        "competition_count": -1,
        "monthly_profit": 1000,
        "payback_ratio": 0.03
      },
      "reason_template": "Build inventory buffer and negotiate supplier terms."
    },
    {
      "action_id": "risk.insure",
      "effects": {
        "cash_flow": -5000,
        "monthly_profit": -300,
        "payback_ratio": 0.01
      },
      "reason_template": "Purchase property and inventory insurance."
    }
  ],
  "intervention_effects": [
    {
      "action_id": "intervention.cut_costs",
      "effects": {
        "cash_flow": 50000,
        "monthly_profit": 4000,
        "payback_ratio": 0.08
      },
      "reason_template": "Negotiate lower rent and reduce slow-moving inventory."
    },
    {
      "action_id": "intervention.expand_marketing",
      "effects": {
        "cash_flow": -25000,
        "customer_flow": 30,
        "monthly_profit": 5000,
        "payback_ratio": 0.03
      },
      "reason_template": "Launch neighborhood promotion to drive foot traffic."
    },
    {
      "action_id": "intervention.reprice",
      "effects": {
        "cash_flow": 15000,
        "customer_flow": -8,
        "monthly_profit": 5000,
        "payback_ratio": 0.06
      },
      "reason_template": "Increase margins on high-demand categories."
    },
    {
      "action_id": "intervention.hold",
      "effects": {
        "cash_flow": 0,
        "monthly_profit": 0,
        "payback_ratio": 0
      },
      "reason_template": "Maintain current pricing and operations."
    }
  ],
  "end_conditions": {
    "bankrupt": {
      "metric": "cash_flow",
      "operator": "<=",
      "threshold": 0
    },
    "goal_reached": {
      "metric": "payback_ratio",
      "operator": ">=",
      "threshold": 1
    },
    "steady_state": {
      "metric": "monthly_profit",
      "operator": ">=",
      "threshold": 60000
    },
    "timeout_years": 5
  },
  "intervention_rules": [
    {
      "rule_id": "cash_pressure",
      "metric": "cash_flow",
      "operator": "<=",
      "threshold": 100000,
      "event": "Inventory costs are squeezing cash reserves.",
      "options": ["cut_costs", "expand_marketing"],
      "max_uses": 1
    },
    {
      "rule_id": "customer_pressure",
      "metric": "customer_flow",
      "operator": "<=",
      "threshold": 70,
      "event": "Customer flow is below the operating threshold.",
      "options": ["reprice", "hold"],
      "max_uses": 2
    }
  ]
}
