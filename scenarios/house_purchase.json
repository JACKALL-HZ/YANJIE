{
  "scenario_id": "house_purchase",
  "title": "买房决策推演",
  "version": 1,
  "decision_vars": [
    { "name": "city", "value_type": "string", "required": true, "default": "杭州" },
    { "name": "budget", "value_type": "integer", "required": true, "default": 2000000, "minimum": 200000, "maximum": 20000000 },
    { "name": "income", "value_type": "integer", "required": true, "default": 30000, "minimum": 3000, "maximum": 200000 },
    { "name": "span_years", "value_type": "integer", "required": false, "default": 5, "minimum": 1, "maximum": 10 }
  ],
  "initial_world_state": {
    "cash_flow": 600000,
    "customer_flow": 3,
    "competition_count": 60,
    "monthly_profit": 12000,
    "payback_ratio": 0.3
  },
  "state_metrics": [
    { "metric_id": "down_payment_reserve", "label": "首付后资金缓冲", "unit": "元", "initial_value": 0, "display_order": 1, "source_metric": "cash_flow" },
    { "metric_id": "home_selection", "label": "可比较房源", "unit": "套", "initial_value": 0, "display_order": 2, "source_metric": "customer_flow" },
    { "metric_id": "market_heat", "label": "市场与政策压力", "unit": "分", "initial_value": 0, "display_order": 3, "source_metric": "competition_count" },
    { "metric_id": "mortgage_pressure", "label": "月供承受力", "unit": "元/月", "initial_value": 0, "display_order": 4, "source_metric": "monthly_profit" },
    { "metric_id": "purchase_readiness", "label": "购房准备度", "unit": "%", "initial_value": 0, "display_order": 5, "source_metric": "payback_ratio" }
  ],
  "agents": [
    { "agent_id": "market", "name": "房产市场智能体", "stance": "分析房价走势与供需关系", "goal": "评估目标城市的房价趋势与购房时机", "action_ids": ["market.track_price", "market.compare_regions"] },
    { "agent_id": "environment", "name": "政策环境智能体", "stance": "关注房贷政策与调控信号", "goal": "监控限购、贷款利率与税收政策变化", "action_ids": ["environment.monitor_loan", "environment.analyze_policy"] },
    { "agent_id": "personal", "name": "个人财务智能体", "stance": "评估还款能力与生活品质", "goal": "平衡月供压力与生活质量", "action_ids": ["personal.optimize_budget", "personal.increase_income"] },
    { "agent_id": "risk", "name": "风险评估智能体", "stance": "识别房产贬值与断供风险", "goal": "防范房价下跌、利率上升等风险", "action_ids": ["risk.stress_test", "risk.diversify_assets"] }
  ],
  "action_effects": [
    { "action_id": "market.track_price", "effects": { "cash_flow": -1000, "customer_flow": 2, "competition_count": -3, "monthly_profit": 500, "payback_ratio": 0.03 }, "reason_template": "持续跟踪目标区域房价走势，寻找最佳入手时机。" },
    { "action_id": "market.compare_regions", "effects": { "cash_flow": -3000, "customer_flow": 4, "competition_count": -8, "monthly_profit": -1000, "payback_ratio": 0.05 }, "reason_template": "对比多个区域性价比，优化购房选择。" },
    { "action_id": "environment.monitor_loan", "effects": { "cash_flow": -500, "customer_flow": 1, "monthly_profit": 2000, "payback_ratio": 0.04 }, "reason_template": "关注贷款利率变动，选择合适的贷款时机。" },
    { "action_id": "environment.analyze_policy", "effects": { "cash_flow": -1000, "competition_count": -5, "monthly_profit": 1000, "payback_ratio": 0.06 }, "reason_template": "分析限购政策变化，评估购房资格与成本。" },
    { "action_id": "personal.optimize_budget", "effects": { "cash_flow": 15000, "monthly_profit": 3000, "payback_ratio": 0.05 }, "reason_template": "优化家庭支出结构，提高月供承受能力。" },
    { "action_id": "personal.increase_income", "effects": { "cash_flow": 30000, "monthly_profit": 5000, "payback_ratio": 0.08 }, "reason_template": "通过副业或投资增加家庭收入来源。" },
    { "action_id": "risk.stress_test", "effects": { "cash_flow": -2000, "monthly_profit": -500, "payback_ratio": 0.04 }, "reason_template": "模拟利率上升和收入下降情景，评估抗风险能力。" },
    { "action_id": "risk.diversify_assets", "effects": { "cash_flow": -20000, "customer_flow": -1, "monthly_profit": 2000, "payback_ratio": 0.03 }, "reason_template": "分散资产配置，降低房产占比过高的风险。" }
  ],
  "intervention_effects": [
    { "action_id": "intervention.buy_now", "effects": { "cash_flow": -500000, "customer_flow": -3, "monthly_profit": -8000, "payback_ratio": 0.5 }, "reason_template": "立即购房，锁定当前价格和利率。" },
    { "action_id": "intervention.wait", "effects": { "cash_flow": 2000, "customer_flow": 2, "monthly_profit": 1000, "payback_ratio": 0.01 }, "reason_template": "继续观望，等待更合适的时机。" },
    { "action_id": "intervention.reduce_budget", "effects": { "cash_flow": 100000, "customer_flow": 3, "competition_count": -10, "monthly_profit": 3000, "payback_ratio": 0.1 }, "reason_template": "降低购房预算，选择更小的户型或偏远的区域。" }
  ],
  "end_conditions": {
    "bankrupt": { "metric": "cash_flow", "operator": "<=", "threshold": 0 },
    "goal_reached": { "metric": "payback_ratio", "operator": ">=", "threshold": 0.9 },
    "steady_state": { "metric": "monthly_profit", "operator": ">=", "threshold": 20000 },
    "timeout_years": 5
  },
  "intervention_rules": [
    { "rule_id": "price_surge", "metric": "competition_count", "operator": ">=", "threshold": 70, "event": "房价快速上涨，市场竞争加剧，需要做出决策。", "options": ["立即入手", "继续观望"], "option_actions": { "立即入手": "intervention.buy_now", "继续观望": "intervention.wait" }, "max_uses": 1 },
    { "rule_id": "rate_hike", "metric": "monthly_profit", "operator": "<=", "threshold": 5000, "event": "利率上调导致月供压力增大。", "options": ["降低预算", "暂缓购房"], "option_actions": { "降低预算": "intervention.reduce_budget", "暂缓购房": "intervention.wait" }, "max_uses": 1 }
  ]
}
