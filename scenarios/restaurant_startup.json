{
  "scenario_id": "restaurant_startup",
  "title": "小餐馆创业",
  "version": 1,
  "decision_vars": [
    {
      "name": "budget",
      "value_type": "integer",
      "required": true,
      "default": 200000,
      "minimum": 50000,
      "maximum": 1000000
    },
    {
      "name": "city",
      "value_type": "string",
      "required": true,
      "default": "chengdu"
    },
    {
      "name": "industry",
      "value_type": "string",
      "required": true,
      "default": "restaurant"
    },
    {
      "name": "span_years",
      "value_type": "integer",
      "required": false,
      "default": 2,
      "minimum": 1,
      "maximum": 3
    }
  ],
  "initial_world_state": {
    "cash_flow": 200000,
    "customer_flow": 120,
    "competition_count": 80,
    "monthly_profit": -8000,
    "payback_ratio": 0
  },
  "agents": [
    {
      "agent_id": "market",
      "name": "市场智能体",
      "stance": "关注顾客需求与竞争格局",
      "goal": "提升获客能力，同时避免耗尽现金储备",
      "action_ids": ["market.differentiate", "market.hold"]
    },
    {
      "agent_id": "environment",
      "name": "环境智能体",
      "stance": "关注所在地与经营环境",
      "goal": "让门店适应当地经营条件",
      "action_ids": ["environment.localize", "environment.monitor"]
    },
    {
      "agent_id": "personal",
      "name": "个人智能体",
      "stance": "关注创始人的能力与精力",
      "goal": "让创始人保持可持续的执行节奏",
      "action_ids": ["personal.stabilize", "personal.defer"]
    },
    {
      "agent_id": "risk",
      "name": "风险智能体",
      "stance": "关注下行损失与脆弱点",
      "goal": "限制不可逆损失和竞争压力",
      "action_ids": ["risk.contain", "risk.insure"]
    }
  ],
  "action_effects": [
    {
      "action_id": "market.differentiate",
      "effects": {
        "cash_flow": -25000,
        "customer_flow": 40,
        "competition_count": -5,
        "monthly_profit": 8000,
        "payback_ratio": 0.1
      },
      "reason_template": "Launch signature dish and social media marketing to build brand."
    },
    {
      "action_id": "market.hold",
      "effects": {
        "cash_flow": -5000,
        "customer_flow": 5,
        "monthly_profit": 500,
        "payback_ratio": 0.02
      },
      "reason_template": "Maintain current menu and rely on word-of-mouth."
    },
    {
      "action_id": "environment.localize",
      "effects": {
        "cash_flow": -10000,
        "customer_flow": 15,
        "monthly_profit": 2000,
        "payback_ratio": 0.05
      },
      "reason_template": "Adjust menu and pricing to local tastes and income levels."
    },
    {
      "action_id": "environment.monitor",
      "effects": {
        "cash_flow": -2000,
        "monthly_profit": 300,
        "payback_ratio": 0.01
      },
      "reason_template": "Observe competitor traffic and seasonal demand patterns."
    },
    {
      "action_id": "personal.stabilize",
      "effects": {
        "cash_flow": -8000,
        "monthly_profit": 1500,
        "payback_ratio": 0.04
      },
      "reason_template": "Hire one chef to reduce founder's kitchen hours."
    },
    {
      "action_id": "personal.defer",
      "effects": {
        "cash_flow": -1500,
        "monthly_profit": 100,
        "payback_ratio": 0.01
      },
      "reason_template": "Keep skeleton crew, owner works all shifts."
    },
    {
      "action_id": "risk.contain",
      "effects": {
        "cash_flow": -8000,
        "competition_count": -2,
        "monthly_profit": 500,
        "payback_ratio": 0.03
      },
      "reason_template": "Stockpile key ingredients and negotiate fixed-price supplier contracts."
    },
    {
      "action_id": "risk.insure",
      "effects": {
        "cash_flow": -4000,
        "monthly_profit": -200,
        "payback_ratio": 0.01
      },
      "reason_template": "Purchase food safety and fire insurance."
    }
  ],
  "intervention_effects": [
    {
      "action_id": "intervention.cut_costs",
      "effects": {
        "cash_flow": 40000,
        "monthly_profit": 4000,
        "payback_ratio": 0.08
      },
      "reason_template": "Reduce ingredient waste and cut non-essential spending."
    },
    {
      "action_id": "intervention.expand_marketing",
      "effects": {
        "cash_flow": -15000,
        "customer_flow": 35,
        "monthly_profit": 5000,
        "payback_ratio": 0.04
      },
      "reason_template": "Food delivery platform promotion and influencer tasting event."
    },
    {
      "action_id": "intervention.reprice",
      "effects": {
        "cash_flow": 10000,
        "customer_flow": -10,
        "monthly_profit": 6000,
        "payback_ratio": 0.06
      },
      "reason_template": "Raise prices 10% on best-selling dishes."
    },
    {
      "action_id": "intervention.hold",
      "effects": {
        "cash_flow": 0,
        "monthly_profit": 0,
        "payback_ratio": 0
      },
      "reason_template": "Keep current pricing and operations."
    }
  ],
  "end_conditions": {
    "bankrupt": {
      "metric": "cash_flow",
      "operator": "<=",
      "threshold": 0
    },
    "goal_reached": {
      "metric": "payback_ratio",
      "operator": ">=",
      "threshold": 1
    },
    "steady_state": {
      "metric": "monthly_profit",
      "operator": ">=",
      "threshold": 40000
    },
    "timeout_years": 3
  },
  "intervention_rules": [
    {
      "rule_id": "cash_pressure",
      "metric": "cash_flow",
      "operator": "<=",
      "threshold": 50000,
      "event": "Operating cash is dangerously low — make a choice.",
      "options": ["cut_costs", "expand_marketing"],
      "max_uses": 1
    },
    {
      "rule_id": "customer_pressure",
      "metric": "customer_flow",
      "operator": "<=",
      "threshold": 80,
      "event": "Customer flow is below survival threshold.",
      "options": ["reprice", "hold"],
      "max_uses": 2
    }
  ]
}
