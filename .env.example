# ============================================================
# 衍界 YanJie AI · 环境变量模板（复制为 .env 并填入真实值）
# ============================================================

# --- 基础 ---
SCENARIO_DIR=scenarios
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUSTED_PROXY_IPS=
LLM_USE_STUB=0
MAX_YEARS=10
MAX_INTERVENTIONS=3

# --- 快模型（Agent 年度决策，80% 调用量，DeepSeek V3）---
FAST_LLM_BASE_URL=https://api.deepseek.com/v1
FAST_LLM_API_KEY=sk-your-deepseek-api-key
FAST_LLM_MODEL=deepseek-chat
FAST_LLM_TEMPERATURE=0.7
FAST_LLM_TIMEOUT=30
FAST_LLM_MAX_RETRIES=2

# --- 慢模型（Judge 校验 + 行动计划，DeepSeek R1）---
SLOW_LLM_BASE_URL=https://api.deepseek.com/v1
SLOW_LLM_API_KEY=sk-your-deepseek-api-key
SLOW_LLM_MODEL=deepseek-reasoner
SLOW_LLM_TEMPERATURE=0.0
SLOW_LLM_TIMEOUT=60
SLOW_LLM_MAX_RETRIES=3

# --- Embedding 模型（bge-m3，硅基流动 API）---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-api-key
EMBEDDING_TIMEOUT=8
RAG_ENABLED=1

# --- 数据库 ---
DATABASE_URL=sqlite:///yanjie_dev.db

# --- LangGraph Checkpointer（开发期 memory 零开销，生产 sqlite:///yanjie_checkpoint.db）---
CHECKPOINTER_URL=memory

# --- 外部搜索（Tavily Search）---
TAVILY_API_KEY=tvly-your-tavily-api-key
WEB_SEARCH_ENABLED=0

# --- 开发调试 ---
# SSE 事件间延迟（ms），stub 模式设 300-800 可模拟真模型推演节奏，生产设为 0
SIMULATION_EVENT_DELAY_MS=0
