# ============================================================
# 衍界 YanJie AI · 后端生产环境变量
# 复制为 deploy/backend.env 并填入真实值；docker-compose 通过 env_file 注入。
# ============================================================

APP_ENV=production
SCENARIO_DIR=scenarios
LLM_USE_STUB=0
MAX_YEARS=10
MAX_INTERVENTIONS=3

# --- 快模型（DeepSeek V3，Agent 年度决策）---
FAST_LLM_BASE_URL=https://api.deepseek.com/v1
FAST_LLM_API_KEY=sk-your-deepseek-key
FAST_LLM_MODEL=deepseek-chat
FAST_LLM_TEMPERATURE=0.7
FAST_LLM_TIMEOUT=30
FAST_LLM_MAX_RETRIES=2

# --- 慢模型（DeepSeek R1，Judge 校验 + 行动计划）---
SLOW_LLM_BASE_URL=https://api.deepseek.com/v1
SLOW_LLM_API_KEY=sk-your-deepseek-key
SLOW_LLM_MODEL=deepseek-reasoner
SLOW_LLM_TEMPERATURE=0.0
SLOW_LLM_TIMEOUT=60
SLOW_LLM_MAX_RETRIES=3

# --- Embedding（bge-m3，硅基流动）---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_TIMEOUT=8
RAG_ENABLED=1

# --- 业务数据库（SQLAlchemy 格式，必须带 +psycopg 方言）---
DATABASE_URL=postgresql+psycopg://yanjie:yanjie_pw@db:5432/yanjie

# --- LangGraph Checkpointer（原生格式，不要 +psycopg 方言）---
CHECKPOINTER_URL=postgresql://yanjie:yanjie_pw@db:5432/yanjie

# --- 向量库持久化目录（容器内挂卷）---
CHROMA_PERSIST_DIR=/app/chroma_data

# --- 外部搜索（可选）---
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=0
MCP_ENABLED=0

# --- 安全 ---
# JWT_SECRET 必须 >=32 字节随机串；可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=replace-with-at-least-32-random-bytes-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS（生产禁止 *，填真实前端域名，逗号分隔）---
ALLOWED_ORIGINS=https://your-domain.com

# --- 反代信任（留空则按 nginx IP 做全局限流；按 IP 限流需切 Redis 限流，见 README P1）---
TRUSTED_PROXY_IPS=

# --- 限流 ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- 推演节奏（生产设为 0）---
SIMULATION_EVENT_DELAY_MS=0
